class Solution(object):
    def countCommas(self, n):
        """
        :type n: int
        :rtype: int
        """
        if(n<1000):
            return 0
        elif(n>=1000 and n<1000000):
            return n-1000+1
        elif(n>=1000000 and n<1000000000):
            return 999000+((n-1000000+1)*2)
        elif(n>=1000000000 and n<1000000000000):
            return 999000+999000000*2+((n-1000000000+1)*3)
        elif(n>=1000000000000 and n<1000000000000000):
            return 999000+999000000*2+999000000000*3+((n-1000000000000+1)*4)
        else:
            return 999000+999000000*2+999000000000*3+999000000000000*4+((n-1000000000000000+1)*5)
